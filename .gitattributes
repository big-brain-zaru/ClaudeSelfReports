# Keep binaries byte-exact and normalise text to LF in the repository (same convention as the other research repos).
* text=auto

*.pdf   binary
*.png   binary
*.npz   binary
*.npy   binary

# Result data, logs, code and papers: LF in the repository and on every checkout, never CRLF-converted.
*.json  text eol=lf
*.jsonl text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.log   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.tex   text eol=lf
*.md    text eol=lf
*.cff   text eol=lf
*.sha256 text eol=lf
